# Python
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
env/

# YOLO model weights — auto-downloaded by ultralytics on first run
*.pt
*.onnx

# Pipeline I/O — generated at runtime, not source
proxies/
input/
output/
*.xml
!samples/*.xml

# macOS
.DS_Store
._*

# PyInstaller build output
build/
dist/

# Bundled FFmpeg binaries — fetched by CI at build time, not source
bin/

# Runtime logs
logs/

# Editor
.vscode/
.idea/
*.swp
.gstack/

# Agent / design tooling (installed locally, not product source)
.claude/*
# except gstack team-mode enforcement (teammates need these committed)
!.claude/settings.json
!.claude/hooks
.claude/hooks/*
!.claude/hooks/check-gstack.sh
.github/skills/
.impeccable/
static/.impeccable/

# Internal strategy / ops docs — never ship to a public repo
docs/

# Tester feedback / run logs / sample footage — internal, never ship
SteadyCut_Feedback/
*_Feedback/

# macOS resource-fork junk
._.git
